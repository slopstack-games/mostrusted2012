#!/bin/sh
# Steam launch wrapper for NFS Most Wanted (2012), used by `tools/orig/orig`.
#
# Set once in Steam: Need for Speed Most Wanted -> Properties -> General -> Launch Options:
#     /path/to/mostrusted2012/tools/orig/orig-wrap %command%
#
# Normal launches are untouched. When `orig launch` has left a request file, the game starts inside gamescope
# (its own nested display: always focused, keyboard / mouse injection and screenshots without touching the
# desktop), and the nested display's environment is written to the state directory for `orig`.
DIR="${XDG_RUNTIME_DIR:-/tmp}/mostrusted-orig"
# The request stays until `orig quit` (a relaunch, e.g. by the EA app after it updated itself, must stay headless
# too: 2026-11-17 one ran on the user's desktop); a request older than 15 minutes is stale and dropped, so a forgotten
# one never takes over the user's own launches.
if [ -f "$DIR/request" ] && [ -n "$(find "$DIR/request" -mmin +15 2> /dev/null)" ]; then
    rm -f "$DIR/request"
fi
if [ -f "$DIR/request" ]; then
    # shellcheck disable=SC1091
    . "$DIR/request"
    rm -f "$DIR/state.env"
    echo $$ > "$DIR/gamescope.pid"
    # Headless runs are never audible: the game's stream goes to a null sink (no per-application mute is stored, so
    # the user's own launches keep their sound). SOUND=1 in the request keeps the normal output.
    if [ -z "$SOUND" ]; then
        s="$("$(dirname "$0")/../silent-sink" 2> /dev/null)" && export PULSE_SINK="$s" PIPEWIRE_NODE="$s"
    fi
    # The probe (docs/probe.md): only for runs that asked for it. Proton appends its own overrides to ours.
    if [ -n "$PROBE_OVERRIDE" ]; then
        export WINEDLLOVERRIDES="${WINEDLLOVERRIDES:+$WINEDLLOVERRIDES;}$PROBE_OVERRIDE"
        export MW_PROBE_OUT="$PROBE_OUT"
    fi
    exec gamescope --backend "${BACKEND:-headless}" -W "${W:-1280}" -H "${H:-720}" -w "${W:-1280}" -h "${H:-720}" \
        -- sh -c 'env | grep -E "^(DISPLAY|GAMESCOPE_WAYLAND_DISPLAY)=" > "$0/state.env"; exec "$@"' "$DIR" "$@"
fi
exec "$@"
