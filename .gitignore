/target
# Ghidra databases and anything extracted from the game are derived from
# copyrighted data and must never be committed.
/re/ghidra_project
/re/*.log
/re/out
/extracted
*.dds

# Live-game measurements (mwtool memscan / telemetry)
*.watch
*.csv
.claude/

# Decompiled dumps and notes about them: never commit (docs/reverse-engineering.md)
/re/*.tar
/re/*.md
/re/NFS13_dump/
/re/vita/

# Reference runs of the original (mwtool capture): game audio and measurements
/ref/

# Agent scratch space (screenshots, traces, binaries)
/scratch/

# Stray dump / disassembly notes agents leave at the root (never commit dump output)
/scratch_*
/*.wav
